# --- Supabase (RedRadar's OWN project — not Cueful's) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
# Server-only. Used by /api/discover to upsert leads past RLS.
NUXT_SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# --- Reply drafts (server-side only) ---
# Used by /api/draft. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Reddit ---
# Optional. With credentials, discovery uses the OAuth API (higher rate limits).
# Without them it falls back to the public www.reddit.com JSON endpoints.
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=redradar/0.1 (lead discovery)
