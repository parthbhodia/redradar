# --- Local dogfood (SQLite, no Supabase required) ---
# Set to 1 to run without a dedicated Supabase project.
REDRADAR_LOCAL=1

# --- Supabase (RedRadar's OWN project — not Cueful's) ---
# Required when REDRADAR_LOCAL is unset/false.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
# Server-only. Used by /api/discover to upsert leads past RLS.
NUXT_SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# --- Reply drafts (server-side only) ---
ANTHROPIC_API_KEY=

# --- Reddit ---
# Optional OAuth. Without credentials, discovery tries OpenCLI then public JSON.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=redradar/0.1 (lead discovery)
# Set to 0 to skip OpenCLI Chrome-bridge search.
REDDIT_USE_OPENCLI=1

# --- Scheduled scans ---
# Shared secret for POST /api/cron/scan-all (x-cron-secret header).
# Leave empty to disable the endpoint.
CRON_SECRET=
