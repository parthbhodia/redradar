# --- Local dogfood (SQLite, no Supabase required) ---
# Set to 1 to run without a dedicated Supabase project.
REDRADAR_LOCAL=1

# --- Supabase (RedIntelli's OWN project — not Cueful's) ---
# Required when REDRADAR_LOCAL is unset/false.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
# Server-only. Used by /api/discover to upsert leads past RLS.
NUXT_SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# --- Reply drafts (server-side only, uses Qwen via Alibaba DashScope) ---
QWEN_API_KEY=
# Workspace-scoped keys use a per-workspace regional host, not the generic
# dashscope.aliyuncs.com. Check the API-KEY dialog in the console for the
# exact "OpenAI 兼容地址" (OpenAI-compatible address) value — it looks like
# https://ws-xxxxxxxxxxxx.<region>.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Reddit ---
# Optional OAuth. Without credentials, discovery tries OpenCLI then public JSON.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=redintelli/0.1 (lead discovery)
# Set to 0 to skip OpenCLI Chrome-bridge search.
REDDIT_USE_OPENCLI=1

# --- Scheduled scans ---
# Shared secret for POST /api/cron/scan-all (x-cron-secret header).
# Leave empty to disable the endpoint.
CRON_SECRET=

# --- Limits ---
# Comma-separated emails exempt from the daily scan limit.
ADMIN_EMAILS=

# Both default to 3 if unset. On Vercel you can also set these as
# NUXT_PUBLIC_MAX_ORG_MEMBERS / NUXT_PUBLIC_DAILY_SCAN_LIMIT to change them
# without a rebuild.
MAX_ORG_MEMBERS=3
DAILY_SCAN_LIMIT=3
# NOTE: MAX_ORG_MEMBERS only covers the app-level check. The database trigger
# that closes the invite race reads its own setting — Postgres cannot see this
# file. To change both, also run:
#   alter database postgres set app.max_org_members = <n>;
